    "m_FunctionBody": "// 1. Сразу даем значение, чтобы компилятор не ругался\nOut = float4(0,0,0,0);\n\nfloat4 col = float4(0, 0, 0, 0);\nfloat kernelSum = 0;\nint range = (int)max(0, Blur); \n\nfor (int x = -range; x <= range; x++) {\n    for (int y = -range; y <= range; y++) {\n        // TexelSize должен быть 1.0 / TextureResolution\n        float2 offset = float2(x, y) * TexelSize;\n        col += SAMPLE_TEXTURE2D(Texture, Sampler, UV + offset);\n        kernelSum++;\n    }\n}\n\n// 2. Проверяем, набралось ли что-то в цикле\nif (kernelSum > 0) {\n    Out = col / kernelSum;\n} else {\n    Out = SAMPLE_TEXTURE2D(Texture, Sampler, UV);\n}\n"
}

