      type: {class: TutorialGameManager/BotReactOnStat, ns: , asm: Assembly-CSharp}
      data:
        showTime: -1
        bot: 3
        texts:
        - text: Not the worst age.
          stat: 1
        - text: Well, he definitely knows how to explain things.
          stat: 2
        - text: "That\u2019s kinda not much."
          stat: 3
    - rid: 6684008413661233256
      type: {class: TutorialGameManager/Wait, ns: , asm: Assembly-CSharp}
      data:
        time: 4
    - rid: 6684008413661233257
      type: {class: TutorialGameManager/BotSay, ns: , asm: Assembly-CSharp}
      data:
        text: "I do have experience working as a psychologist \u2014 I\u2019ll be
          able to help if people start panicking."
        showTime: -1
        bot: 1
    - rid: 6684008413661233258
      type: {class: TutorialGameManager/Wait, ns: , asm: Assembly-CSharp}
      data:
        time: 4
    - rid: 6684008413661233259
      type: {class: TutorialGameManager/BotShowStat, ns: , asm: Assembly-CSharp}
      data:
        stat: 3
        bot: 1
    - rid: 6684008413661233260
      type: {class: TutorialGameManager/BotSay, ns: , asm: Assembly-CSharp}
      data:
        text: "And I\u2019ve got work experience too, so a soldier with those kinds
          of skills is definitely useful."
        showTime: -1
        bot: 3
    - rid: 6684008413661233261
      type: {class: TutorialGameManager/BotShowStat, ns: , asm: Assembly-CSharp}
      data:
        stat: 3
        bot: 3
    - rid: 6684008413661233262
      type: {class: TutorialGameManager/BotSay, ns: , asm: Assembly-CSharp}
      data:
        text: "I think it\u2019s pretty obvious who won\u2019t help us survive here."
        showTime: -1
        bot: 1
    - rid: 6684008413661233263
