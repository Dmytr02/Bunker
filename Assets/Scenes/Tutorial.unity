  book2: {fileID: 1183955442}
  card: {fileID: 1792378408}
  inventoryIcon: {fileID: 1071164964}
  hintText: {fileID: 1994929690}
  Boty:
  - {fileID: 1079129373}
  - {fileID: 717954629}
  - {fileID: 1962181202}
  - {fileID: 591752304}
  - {fileID: 1621499194}
  hintObjects:
  - go:
    - {fileID: 228968880}
    text: In your notebook, you can view and share your stats with other players.
      (press "space to continue")
  - go:
    - {fileID: 382755578}
    text: Click on the stat to share it.
  - go:
    - {fileID: 1535558145}
    text: "\u201CClick when you\u2019re ready.\u201D The real game will begin \u2014
      your decisions will matter."
  - go:
    - {fileID: 192921504}
    text: "\u201CThis is the player book.\u201D\nHere you can view your and other
      players\u2019 stats. Use it to make decisions and apply special cards.\nClick
      to turn the page."
  - go:
    - {fileID: 1812777343}
    text: "\u201CThis is your inventory.\u201D\nOpen it to see what\u2019s inside."
  - go:
    - {fileID: 1183955442}
    - {fileID: 1792378408}
    text: "\u201CThese are your cards.\u201D\nYou can use them during the game\nDrag
      one of them onto the corresponding player`s page to use it."
  - go:
    - {fileID: 1682350392}
    text: "\u201CTime to vote.\u201D\nChoose who to vote for, then press Submit."
  darkImage: {fileID: 528076784}
  triger: 0
  _triger2: 0
